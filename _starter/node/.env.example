# Variáveis de ambiente — copie pra .env e preencha
# .env é ignorado pelo git. NUNCA commite credenciais.

# Identificação do projeto (usado em logs)
PROJECT_NAME=PROJECT_NAME_PLACEHOLDER
ENVIRONMENT=development  # development | staging | production
NODE_ENV=development

# Logging
LOG_LEVEL=info  # trace | debug | info | warn | error
LOG_FORMAT=pretty  # pretty | json

# === Credenciais por integração ===
# Adicione aqui só o que esse projeto realmente precisa.

# Google APIs (se usar Sheets, Calendar, Drive)
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json

# APIs internas Fast
# SAP_API_URL=
# SAP_API_TOKEN=
# SULTS_API_URL=
# SULTS_API_TOKEN=

# Notion (se usar)
# NOTION_API_KEY=
# NOTION_DATABASE_ID=

# Anthropic (se usar Claude API)
# ANTHROPIC_API_KEY=

# Webhook de alertas (Slack/Discord/email)
# ALERT_WEBHOOK_URL=
