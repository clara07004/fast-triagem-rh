{
  "name": "PROJECT_NAME_PLACEHOLDER",
  "version": "0.1.0",
  "description": "PROJECT_DESCRIPTION_PLACEHOLDER",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write 'src/**/*.js' 'tests/**/*.js'",
    "prepare": "test -d .git && (test -f .husky/pre-commit || true) || true"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "vitest": "^1.6.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0"
  },
