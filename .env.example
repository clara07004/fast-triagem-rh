# Variáveis de ambiente — copie pra .env e preencha
# .env é ignorado pelo git. NUNCA commite credenciais.

# Identificação do projeto (usado em logs)
PROJECT_NAME=fast_triagem_rh
ENVIRONMENT=development  # development | staging | production

# Logging
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json  # json | console

# === Credenciais ===

# Claude API (Anthropic) — obrigatória pra análise dos CVs
ANTHROPIC_API_KEY=

# === Servidor (VPS SaveinCloud) — ver docs/DEPLOY_VPS_SAVEINCLOUD.md ===
# Senha única do time pra acessar o app pelo navegador.
# No uso local (app instalado na máquina), deixe vazio — o app abre direto.
TRIAGEM_SENHA=

# Domínio que o Caddy usa pra emitir o certificado HTTPS.
# Ex.: triagem.fastdrywall.com.br ou o hostname do VPS na SaveinCloud.
DOMINIO=
