# Esse é o .env.example da raiz do template.
# Quando você roda init.sh / init.ps1, o .env.example da stack escolhida (Python ou Node)
# vira o .env.example principal do projeto.
#
# Esse arquivo aqui serve como referência de variáveis que costumam aparecer
# em projetos da Fast — copie pro seu .env conforme precisar.

# === Obrigatórias em todo projeto ===
PROJECT_NAME=
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# === APIs internas Fast ===
# SAP_API_URL=
# SAP_API_TOKEN=
# SULTS_API_URL=
# SULTS_API_TOKEN=
# PIPERUN_API_URL=
# PIPERUN_API_TOKEN=
# NASAJON_API_URL=
# NASAJON_API_TOKEN=

# === Google Workspace ===
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json

# === Notion ===
# NOTION_API_KEY=
# NOTION_DATABASE_ID=

# === Anthropic (Claude API) ===
# ANTHROPIC_API_KEY=

# === Alertas ===
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL_TO=
